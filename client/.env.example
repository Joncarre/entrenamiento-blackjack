# Configuracion de Firebase.
#
# Copia este fichero a client/.env y rellena los valores que da la consola
# de Firebase en: Configuracion del proyecto > Tus apps > Web.
#
# Estas claves acaban en el bundle y son publicas por diseno: identifican el
# proyecto, no autorizan nada. Los datos los protege firestore.rules.
#
# En Netlify se definen en Site settings > Environment variables, con estos
# mismos nombres.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
